# Copy this file to ".env" and put your own key after the = sign.
# Get a key at https://console.anthropic.com/settings/keys
# Never commit .env - it is listed in .gitignore.
ANTHROPIC_API_KEY=

# Optional - protect a public deployment:
# APP_ACCESS_CODE=choose-a-code      (visitors must enter it to get recipes)
# RATE_LIMIT_PER_HOUR=10             (per visitor)
# MAX_REQUESTS_PER_DAY=100           (for the whole app)
